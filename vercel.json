{
  "version": 2,
  "builds": [
    {
      "config": {
        "buildCommand": "echo 'Rodando o comando buildCommand' && npx cross-var npx prisma generate --schema %PRISMA_SCHEMA% && nest build"
      },
      "src": "dist/src/main.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/src/main.js",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "PRISMA_SCHEMA": "./src/modules/global/db/prisma/schema.prisma"
  }
}
